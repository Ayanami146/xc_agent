<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xc.agent.mapper.TicketReplyMapper">
    <resultMap id="ReplyMap" type="com.xc.agent.model.po.TicketReplyPO">
        <id property="id" column="id"/><result property="publicId" column="public_id"/>
        <result property="ticketId" column="ticket_id"/><result property="senderType" column="sender_type"/>
        <result property="customerUserId" column="customer_user_id"/><result property="adminUserId" column="admin_user_id"/>
        <result property="senderNameSnapshot" column="sender_name_snapshot"/><result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    <select id="selectByTicketId" resultMap="ReplyMap">
        SELECT id,public_id,ticket_id,sender_type,customer_user_id,admin_user_id,sender_name_snapshot,content,created_at
        FROM ticket_reply WHERE ticket_id=#{ticketId} ORDER BY created_at
    </select>
    <insert id="insert" parameterType="com.xc.agent.model.po.TicketReplyPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ticket_reply(public_id,ticket_id,sender_type,customer_user_id,admin_user_id,sender_name_snapshot,content,created_at)
        VALUES(#{publicId},#{ticketId},#{senderType},#{customerUserId},#{adminUserId},#{senderNameSnapshot},#{content},#{createdAt})
    </insert>
</mapper>
