<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xc.agent.mapper.OperationAuditMapper">
    <resultMap id="AuditMap" type="com.xc.agent.model.po.OperationAuditPO">
        <id property="id" column="id"/><result property="requestId" column="request_id"/>
        <result property="actorType" column="actor_type"/><result property="actorId" column="actor_id"/>
        <result property="actionName" column="action_name"/><result property="resourceType" column="resource_type"/>
        <result property="resourceId" column="resource_id"/><result property="result" column="result"/>
        <result property="detailJson" column="detail_json"/><result property="ipAddress" column="ip_address"/>
        <result property="userAgent" column="user_agent"/><result property="createdAt" column="created_at"/>
    </resultMap>
    <sql id="where">actor_type='ADMIN'
        <if test="operatorId != null and operatorId != ''">AND actor_id=#{operatorId}</if>
        <if test="resourceType != null and resourceType != ''">AND resource_type=#{resourceType}</if>
        <if test="action != null and action != ''">AND action_name=#{action}</if>
        <if test="requestId != null and requestId != ''">AND request_id=#{requestId}</if>
        <if test="from != null">AND created_at &gt;= #{from}</if>
        <if test="to != null">AND created_at &lt; DATE_ADD(#{to},INTERVAL 1 DAY)</if>
    </sql>
    <insert id="insert" parameterType="com.xc.agent.model.po.OperationAuditPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO operation_audit(request_id,actor_type,actor_id,action_name,resource_type,resource_id,result,detail_json,ip_address,user_agent,created_at)
        VALUES(#{requestId},#{actorType},#{actorId},#{actionName},#{resourceType},#{resourceId},#{result},#{detailJson},#{ipAddress},#{userAgent},#{createdAt})
    </insert>
    <select id="selectPage" resultMap="AuditMap">SELECT id,request_id,actor_type,actor_id,action_name,resource_type,resource_id,result,detail_json,ip_address,user_agent,created_at FROM operation_audit WHERE <include refid="where"/> ORDER BY created_at DESC LIMIT #{offset},#{pageSize}</select>
    <select id="countPage" resultType="long">SELECT COUNT(*) FROM operation_audit WHERE <include refid="where"/></select>
</mapper>
