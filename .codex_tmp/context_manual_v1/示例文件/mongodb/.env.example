# 参考实现，尚未自动接入当前项目；复制为 .env 后替换全部占位值。
# 不要把包含真实密码的 .env 提交到 Git。

MONGO_BIND_IP=192.168.100.128

# root 账号仅用于初始化、备份和运维。
MONGO_ROOT_USERNAME=xc_mongo_admin
MONGO_ROOT_PASSWORD=<请替换为至少24位随机密码>

# Python Agent 使用的最小权限账号，只拥有目标数据库 readWrite 权限。
MONGO_APP_USERNAME=agent_context_app
MONGO_APP_PASSWORD=<请替换为不同的至少24位随机密码>
