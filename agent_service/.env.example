# 服务基础配置。变量统一使用 AGENT_ 前缀，避免与 Java 服务变量冲突。
AGENT_ENVIRONMENT=development
AGENT_HOST=127.0.0.1
AGENT_PORT=8100
AGENT_LOG_LEVEL=INFO

# 默认 mock 可以在没有外部模型密钥时运行完整 API 和 SSE 流程。
# 接入真实模型时改为 openai，并配置模型名称和 API Key。
AGENT_MODEL_PROVIDER=mock
AGENT_MODEL_NAME=mock-model
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=
AGENT_MODEL_TIMEOUT_SECONDS=120

# 维修手册 RAG。Java 与 Agent 必须把下面两个 MANUAL_STORAGE_DIRECTORY 配置为
# 同一物理目录/共享卷的绝对路径；MySQL 清单和原文件是真相源，Chroma 可随时重建。
AGENT_RAG_ENABLED=true
AGENT_JAVA_RAG_MANIFEST_URL=http://127.0.0.1:8080/internal/rag/v1/manuals
AGENT_MANUAL_STORAGE_DIRECTORY=C:/work_learn/XinChuang_pc/xc_agent/data/manuals
AGENT_CHROMA_DIRECTORY=C:/work_learn/XinChuang_pc/agent_service/data/chroma
AGENT_CHROMA_COLLECTION=manuals_text_embedding_v3_1024_v1

# 阿里云百炼 OpenAI 兼容接口。北京地域使用下列默认地址，其他地域或专属工作空间
# 只需替换 Base URL。Embedding 密钥与对话模型密钥分开配置。
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_EMBEDDING_MODEL=text-embedding-v3
AGENT_EMBEDDING_DIMENSIONS=1024
AGENT_RAG_CHUNK_SIZE=800
AGENT_RAG_CHUNK_OVERLAP=120
AGENT_RAG_TOP_K=5
AGENT_RAG_SCORE_THRESHOLD=0.35

# 当前生效的角色文件。修改文件后，下一次新聊天请求会自动读取最新角色，无需重启服务。
AGENT_ROLE_CONFIG_PATH=config/active_role.json

# 内部接口最小鉴权开关。开发环境可关闭；部署时至少应启用。
# 正式生产环境后续应升级为“时间戳 + nonce + HMAC”并将 nonce 放入 Redis。
AGENT_INTERNAL_AUTH_ENABLED=false
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token

# 这里只配置 Agent 的 LangGraph 上下文 Redis。它与 Java 的 spring.data.redis / REDIS_*
# 是两个独立服务和数据空间，FAQ 缓存绝不能改用本连接。
# LangGraph Redis Saver 依赖 Redis Search，因此必须使用 database 0，不能改成 /4。
# 将密码、地址和端口替换为实际 Redis 8 配置；密码中的特殊字符需要 URL 编码。
AGENT_CONTEXT_STORAGE_ENABLED=true
AGENT_REDIS_URL=redis://:<Redis密码>@192.168.100.128:6380/0
AGENT_CONTEXT_REDIS_TTL_MINUTES=10080
AGENT_CONTEXT_ARCHIVE_STREAM=xc:agent:context:archive:v1
AGENT_CONTEXT_ARCHIVE_GROUP=mongo-archive-v1
AGENT_CONTEXT_ARCHIVE_CONSUMER=mongo-archive-1
AGENT_CONTEXT_REHYDRATE_TURN_LIMIT=200
AGENT_SESSION_LOCK_TIMEOUT_SECONDS=180

# MongoDB 永久保存完成的对话轮次。用户名和密码中的特殊字符同样需要 URL 编码。
AGENT_MONGODB_URI=mongodb://<用户名>:<密码>@192.168.100.128:27017/xinchuang_agent_context?authSource=admin
AGENT_MONGODB_DATABASE=xinchuang_agent_context
AGENT_MONGODB_CONTEXT_COLLECTION=conversation_turns

# 这是发送给模型的输入上限，不是 Redis TTL，也不是摘要阈值。
AGENT_MODEL_MAX_INPUT_TOKENS=8000
